# Bothost usually injects BOT_TOKEN automatically; otherwise set it in panel.
BOT_TOKEN=put_your_bot_token_here
BOT_USERNAME=your_wishlist_bot
# Replace with your actual Bothost HTTPS domain, no trailing slash.
WEBAPP_URL=https://your-bot-domain.bothost.ru
PUBLIC_BASE_URL=https://your-bot-domain.bothost.ru
DATABASE_PATH=/app/data/wishlist.sqlite3
TELEGRAM_OWNER_IDS=8580512680,1973334354
# Use a long random secret if the app's auth implementation requires it.
APP_SECRET=replace_with_a_long_random_secret
INIT_DATA_MAX_AGE=86400
PORT=3000
